<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件布局。
  🔴 只能用 RemoteViews 支持的控件（LinearLayout / TextView 等），不能用 Compose。
  颜色全部由 Widget.kt 在运行时按主题 setTextColor / setBackgroundResource 注入，
  这里只留结构、字号和排版约束。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_light">

    <!-- 头部：第 N 周 ····· 日期 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="课表" />

        <TextView
            android:id="@+id/w_date"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <!-- 学期进度 / 距放假 -->
    <TextView
        android:id="@+id/w_term"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- 今天还剩 N 节 -->
    <TextView
        android:id="@+id/w_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- 今天课程行（最多 4 行，多余的收进第 4 行） -->
    <LinearLayout
        android:id="@+id/w_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_t0"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/w_c0"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/w_r0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="96dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_t1"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/w_c1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/w_r1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="96dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_t2"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/w_c2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/w_r2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="96dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_t3"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/w_c3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/w_r3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="96dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <!-- 无课 / 提示 -->
    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <!-- 下一节 -->
    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- 电费：本机缓存的电量读数；没查过/没登录时由 Widget.kt 写字样 -->
    <TextView
        android:id="@+id/w_fee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- ── 回声洞：课表下面的自定义一句话（常用功能 → 回声洞 里开关）──
         四帧 ViewFlipper 做「机器故障」：三帧乱码 + 一帧正片，换句时连着播。
         这块吃掉课表之后的余下高度：长句要能整句读完，就得有个确定的高度给字号自动缩放。 -->
    <TextView
        android:id="@+id/w_echo_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_echo_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_echo_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="9.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="回声洞" />

        <ViewFlipper
            android:id="@+id/w_echo_flip"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:measureAllChildren="true"
            android:inAnimation="@anim/echo_in"
            android:outAnimation="@anim/echo_out">

            <TextView
                android:id="@+id/w_echo_t0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:textSize="12.5sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="12.5sp"
                android:autoSizeStepGranularity="1sp"
                android:text="" />

            <TextView
                android:id="@+id/w_echo_t1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:textSize="12.5sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="12.5sp"
                android:autoSizeStepGranularity="1sp"
                android:text="" />

            <TextView
                android:id="@+id/w_echo_t2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:textSize="12.5sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="12.5sp"
                android:autoSizeStepGranularity="1sp"
                android:text="" />

            <TextView
                android:id="@+id/w_echo_t3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="top"
                android:textSize="12.5sp"
                android:maxLines="4"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeMaxTextSize="12.5sp"
                android:autoSizeStepGranularity="1sp"
                android:text="" />
        </ViewFlipper>
    </LinearLayout>
</LinearLayout>
